[Unit]
Description=ttyd web terminal for Herdr
Documentation=https://github.com/tsl0922/ttyd
After=network-online.target
Wants=network-online.target

[Service]
User=@@USER@@
Environment=TERM=xterm-256color
Environment=HOME=@@HOME@@
# Loopback only. The tunnel (Tailscale/Cloudflare) is what exposes it.
ExecStart=@@TTYD_BIN@@ -i 127.0.0.1 -p @@PORT@@ -W -t titleFixed=Herdr@@CRED@@ @@HERDR_BIN@@
Restart=on-failure
RestartSec=2
# Basic hardening for the service itself. Home stays writable on purpose:
# herdr keeps its socket and state under $HOME/.config/herdr.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
